# --- Brief / orchestrator (decision layer) ---
# Optional. If unset, the orchestrator falls back to a deterministic heuristic
# so the graph still runs end-to-end in a demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Caller (ElevenLabs Conversational AI voice agent) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The linked Twilio phone number id from the ElevenLabs dashboard (Phone Numbers).
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# When true (or when ElevenLabs keys are missing), the caller node simulates the
# call instead of dialling. Keep the demo working without telephony wired up.
DRY_RUN=true

# --- Logging ---
LOG_LEVEL=info

# --- OpenAI (hackathon gateway) ---
# The event gateway speaks the OpenAI API; only the key and base URL differ.
# Get your team key from the organisers. NEVER commit it.
OPENAI_API_KEY=sk-...your-team-key...
OPENAI_BASE_URL=https://4.231.223.10.nip.io
# Develop on the fast/cheap model; switch up only where it matters.
# Options: gpt-5.4-mini | gpt-5.4-nano | gpt-5.4 | gpt-5.5 | gpt-5.6-terra | gpt-5.6-luna | gpt-5.6-sol
OPENAI_MODEL=gpt-5.4-mini
# If OPENAI_API_KEY is unset, the orchestrator falls back to a deterministic
# heuristic so the graph still runs end-to-end in a demo.

# --- HTTP server ---
PORT=2024
WEB_APP_ORIGIN=http://localhost:3000

# --- Storage (SQLite via better-sqlite3) ---
# Path is resolved relative to the agent-service working directory. Gitignored.
DATABASE_PATH=./data/app.db

# --- Caller (ElevenLabs Conversational AI voice agent) ---
ELEVENLABS_API_KEY=
# Filled after `npm run agent:push` uploads the agent-as-code config.
ELEVENLABS_AGENT_ID=
# The linked Twilio phone number id from the ElevenLabs dashboard (Phone Numbers).
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Optional: override the agent voice (e.g. a consented clone). Standard voice if unset.
ELEVENLABS_VOICE_ID=
# Optional: shared secret to verify inbound /calls/webhook requests.
ELEVENLABS_WEBHOOK_SECRET=

# When true (or when ElevenLabs keys are missing), the caller simulates the call
# instead of dialling. Keep the demo working without telephony wired up.
DRY_RUN=true

# --- Demo ---
# Phone number the seeded demo user is called on (E.164). Override per trigger too.
DEMO_PHONE_NUMBER=+440000000000

# --- Logging ---
LOG_LEVEL=info

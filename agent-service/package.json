{
  "name": "agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LangGraph orchestration service: one graph, two agents (brief/orchestrator + caller).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/db/seed-cli.ts",
    "agent:push": "elevenlabs agents push",
    "agent:status": "elevenlabs agents status"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.60.0",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "openai": "^7.1.0",
    "pino": "^10.3.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@elevenlabs/cli": "^0.5.6",
    "@langchain/langgraph-cli": "^1.4.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
